                        <div className="space-y-4">
                          <div className="p-4 bg-slate-800/50 rounded-xl border border-slate-700/50">
                            <div className="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1">Privacy Notice (PDPL)</div>
                            
                            <div className="text-xs font-bold text-slate-300">
                              Notice-based — recorded per pre-boarding case
                            </div>
                            <div className="text-[10px] text-slate-400 mt-1 leading-snug">
                              One record per document that can be collected, with its basis, the notice version and the person who showed it. No consent flag is held on the employee record.
                            </div>
                          </div>
    
                          <div className="p-4 bg-slate-800/50 rounded-xl border border-slate-700/50">
                            <div className="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1">EOSB Calculation Basis</div>
                            <div className="text-xs font-bold text-teal-300">
