                            onChange={e => setOfferForm({ ...offerForm, candidate_name: e.target.value })}
                            className="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-teal-500 outline-none text-sm font-medium" />
                        </div>
