                          <h3 className="font-bold text-slate-900">Pre-boarding Intelligence</h3>
                          <span className="px-2 py-0.5 bg-teal-50 text-teal-700 text-[10px] font-bold rounded uppercase border border-teal-200">Layer 2</span>
