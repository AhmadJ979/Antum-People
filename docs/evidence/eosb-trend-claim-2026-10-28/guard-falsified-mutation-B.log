                          const uaeHeight = (s.uae / max) * 100;
                          const ksaHeight = (s.ksa / max) * 100;
                          return (
                            <div key={s.quarter} className="flex-1 flex flex-col items-center group">
                              <div className="w-full max-w-[60px] flex flex-col-reverse h-full relative">
